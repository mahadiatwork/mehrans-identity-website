    <meta name="google-site-verification" content="JQDOMPvRWFlFAGThjtdph3L0neRU5hSvFeJWDmGigN8" />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="bn-BD" href={banglaUrl} />
    <link rel="alternate" hreflang="x-default" href={englishUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mahadi & Mehran — A Digital Legacy" />
    <meta property="og:locale" content={isBn ? 'bn_BD' : 'en_US'} />
    <meta property="og:locale:alternate" content={isBn ? 'en_US' : 'bn_BD'} />
    <meta property="og:title" content={copy.pageTitle} />
    <meta property="og:description" content={copy.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1536" />
    <meta property="og:image:height" content="1024" />
    <meta property="og:image:alt" content={isBn ? 'মাহাদী ও মেহরান—একটি ডিজিটাল লিগ্যাসি' : 'Mahadi and Mehran—A Digital Legacy'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={copy.pageTitle} />
    <meta name="twitter:description" content={copy.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={isBn ? 'মাহাদী ও মেহরান—একটি ডিজিটাল লিগ্যাসি' : 'Mahadi and Mehran—A Digital Legacy'} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{copy.skip}</a>

    <header class="site-header">
      <a class="wordmark" href="#top" aria-label="Mahadi and Mehran, home">
        <span>MAHADI</span><span>× MEHRAN</span>
      </a>
      <nav aria-label={copy.navLabel}>
        <a href="#legacy">{copy.legacyNav}</a>
        <a href="#family">{copy.familyNav}</a>
        <button class="nav-archive" type="button" data-open-archive>{copy.archiveNav} <span aria-hidden="true">↗</span></button>
        <a class="language-switch" href={alternateUrl} lang={isBn ? 'en' : 'bn'} hreflang={isBn ? 'en' : 'bn-BD'} aria-label={copy.languageAria}>{copy.languageLabel}</a>
      </nav>
    </header>

    <main id="main-content">
      <section class="hero" id="top">
        <div class="hero-copy">
          <p class="kicker"><span>{copy.established}</span> 15 · 06 · 2025</p>
          <h1>{copy.heroTitle}<br /><em>{copy.heroOutline}</em></h1>
          <p class="hero-names">{copy.heroNames}</p>
          <p class="hero-intro">{copy.heroIntro}</p>
          <a class="button button-red" href="#legacy">{copy.begin} <span aria-hidden="true">↓</span></a>
        </div>

        <figure class="hero-photo collage-photo">
          <div class="photo-mat">
            <Image src={togetherPhoto} alt={copy.photoAltTogether} widths={[640, 960, 1280]} sizes="(max-width: 820px) 92vw, 43vw" loading="eager" fetchpriority="high" quality={80} format="webp" />
          </div>
          <figcaption>{copy.fatherSon} <span>·</span> {copy.country}</figcaption>
        </figure>

        <p class="vertical-note">{copy.vertical}</p>
        <div class="red-orbit" aria-hidden="true"></div>
        <div class="infinity-mark" aria-hidden="true">∞</div>
      </section>

      <section class="letter" id="legacy">
        <div class="section-index"><span>01</span><p>{copy.noteLabel}</p></div>
        <div class="letter-copy">
          <p class="display-quote">{copy.quoteBefore} <em>{copy.quoteEm}</em> {copy.quoteAfter}</p>
          <p class="letter-body">{copy.letterBody}</p>
          <p class="signature">{copy.signature}</p>
        </div>
      </section>

      <section class="profiles" aria-label={copy.profilesLabel}>
        <article class="profile profile-mahadi" id="mahadi-hasan">
          <figure class="profile-image">
            <Image src={mahadiPhoto} alt={copy.photoAltMahadi} widths={[480, 720, 960]} sizes="(max-width: 820px) 100vw, 42vw" loading="lazy" quality={78} format="webp" />
            <span class="photo-number">01 / {copy.fatherLabel}</span>
          </figure>
          <div class="profile-content">
            <p class="label">{copy.fatherLabel}</p>
            <h2>{copy.fatherName} <em>{copy.fatherNickname}</em></h2>
            <p class="profile-lede">{copy.fatherLede}</p>
            <div class="timeline">
              {copy.education.map((item) => (
                <div><time>{item.years}</time><p><strong>{item.degree}</strong><br />{item.subject}<br />{item.school}</p></div>
              ))}
            </div>
            <div class="profile-links">
              <a href="https://www.linkedin.com/in/mahadihanshan/" rel="me noopener noreferrer" target="_blank">{copy.linkedin} <span aria-hidden="true">↗</span></a>
              <a href="https://ieeexplore.ieee.org/author/37089463675" rel="me noopener noreferrer" target="_blank">{copy.ieee} <span aria-hidden="true">↗</span></a>
            </div>
          </div>
        </article>

        <article class="profile profile-mehran" id="mehran-hasan">
          <div class="profile-content">
            <p class="label">{copy.sonLabel}</p>
            <h2>{copy.sonName} <em>{copy.sonNickname}</em></h2>
            <p class="profile-lede">{copy.sonLede}</p>
            <dl class="birth-record">
              <div><dt>{copy.date}</dt><dd>{copy.dateValue}</dd></div>
              <div><dt>{copy.time}</dt><dd>{copy.timeValue}</dd></div>
              <div><dt>{copy.place}</dt><dd>{copy.placeValue}</dd></div>
            </dl>
            <blockquote>{copy.sonQuote}</blockquote>
          </div>
          <figure class="profile-image profile-image-child">
            <Image src={mehranPhoto} alt={copy.photoAltMehran} widths={[560, 840, 1120]} sizes="(max-width: 820px) 100vw, 48vw" loading="lazy" quality={78} format="webp" />
            <span class="photo-number">02 / {copy.sonLabel}</span>
          </figure>
        </article>
      </section>

      <section class="roots" id="family">
        <div class="roots-heading">
          <p class="label">{copy.rootsLabel}</p>
          <h2>{copy.rootsTitle}<br /><em>{copy.rootsOutline}</em></h2>
          <p>{copy.rootsIntro}</p>
        </div>

        <div class="family-columns">
          <section class="family-branch" aria-labelledby={`paternal-heading-${locale}`}>
            <header>
              <p>{copy.paternalLabel}</p>
              <h3 id={`paternal-heading-${locale}`}>{copy.paternalTitle}</h3>
              <address>{copy.paternalAddress}</address>
            </header>
            {copy.paternalCards.map((card, index) => (
              <article class:list={['family-card', { 'featured-card': index === 0 }]}>
                <span class="relation">{card.relation}</span><h4>{card.name}</h4><p>{card.text}</p>
              </article>
            ))}
          </section>

          <section class="family-branch maternal" aria-labelledby={`maternal-heading-${locale}`}>
            <header>
              <p>{copy.maternalLabel}</p>
              <h3 id={`maternal-heading-${locale}`}>{copy.maternalTitle}</h3>
              <address>{copy.maternalAddress}</address>
            </header>
            {copy.maternalCards.map((card, index) => (
              <article class:list={['family-card', { 'featured-card': index === 0 }]}>
                <span class="relation">{card.relation}</span><h4>{card.name}</h4><p>{card.text}</p>
              </article>
            ))}
          </section>
        </div>
      </section>

      <section class="archive" id="archive">
        <div class="archive-art" aria-hidden="true"><span class="archive-year">25</span><span class="archive-ring"></span><span class="archive-noise">{isBn ? 'স্মৃতি · স্মৃতি · স্মৃতি' : 'MEMORY · MEMORY · MEMORY'}</span></div>
        <div class="archive-copy">
          <p class="label">{copy.archiveLabel}</p>
          <h2>{copy.archiveTitle}<br /><em>{copy.archiveOutline}</em></h2>
          <p>{copy.archiveText}</p>
          <button class="button button-light" type="button" data-open-archive>{copy.unlock} <span aria-hidden="true">↗</span></button>
          <p class="privacy-note"><span aria-hidden="true">●</span> {copy.protected}</p>
        </div>
      </section>
    </main>

    <footer>
      <a class="footer-mark" href="#top">M × M</a>
      <p>{copy.footerMemory}</p>
      <p>{copy.footerPlaces}</p>
    </footer>

    <dialog class="archive-dialog" id="archive-dialog" aria-labelledby="archive-title">
      <button class="dialog-close" type="button" data-close-archive aria-label={copy.closeDialog}>×</button>
      <p class="label">{copy.privateCollection}</p>
      <h2 id="archive-title">{copy.dialogTitle}</h2>
      <p>{copy.dialogText}</p>
      <form id="archive-form">
        <label for="archive-password">{copy.password}</label>
        <div class="password-row"><input id="archive-password" name="password" type="password" autocomplete="current-password" required /><button type="submit" aria-label={copy.unlockAria}>↗</button></div>
        <p class="form-status" id="archive-status" role="status" aria-live="polite"></p>
      </form>
    </dialog>

    <script>
      const dialog = document.querySelector('#archive-dialog');
      const form = document.querySelector('#archive-form');
      const passwordInput = document.querySelector('#archive-password');
      const status = document.querySelector('#archive-status');
      const isBangla = document.documentElement.lang === 'bn';

      document.querySelectorAll('[data-open-archive]').forEach((button) => button.addEventListener('click', () => {
        if (dialog instanceof HTMLDialogElement) {
          dialog.showModal();
          if (passwordInput instanceof HTMLInputElement) passwordInput.focus();
        }
      }));
      document.querySelector('[data-close-archive]')?.addEventListener('click', () => { if (dialog instanceof HTMLDialogElement) dialog.close(); });
      dialog?.addEventListener('click', (event) => { if (event.target === dialog && dialog instanceof HTMLDialogElement) dialog.close(); });

      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!(form instanceof HTMLFormElement) || !(status instanceof HTMLElement)) return;
        const submitButton = form.querySelector('button[type="submit"]');
        const formData = new FormData(form);
        status.textContent = isBangla ? 'যাচাই করা হচ্ছে…' : 'Checking…';
        if (submitButton instanceof HTMLButtonElement) submitButton.disabled = true;
        try {
          const response = await fetch('/api/unlock', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ password: formData.get('password') }) });
          const result = await response.json() as { url?: string; message?: string };
          if (!response.ok || !result.url) throw new Error(isBangla ? (response.status === 503 ? 'আর্কাইভের পাসওয়ার্ড এখনো কনফিগার করা হয়নি।' : 'পাসওয়ার্ডটি সঠিক নয়। আবার চেষ্টা করুন।') : (result.message || 'Incorrect password.'));
          status.textContent = isBangla ? 'খোলা হয়েছে। আর্কাইভে নেওয়া হচ্ছে…' : 'Unlocked. Opening the archive…';
          window.location.assign(result.url);
        } catch (error) {
          status.textContent = error instanceof Error ? error.message : (isBangla ? 'আর্কাইভটি খোলা যায়নি।' : 'The archive could not be opened.');
          if (passwordInput instanceof HTMLInputElement) { passwordInput.select(); passwordInput.focus(); }
        } finally {
          if (submitButton instanceof HTMLButtonElement) submitButton.disabled = false;
        }
      });
    </script>
  </body>
</html>
